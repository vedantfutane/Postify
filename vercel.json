{
    "version": 2,
    "builds": [
      {
        "src": "Postify/TweetLearn/wsgi.py",
        "use": "@vercel/python",
        "config":{"maxLambdaSize": "15mb", "runtime":"python3.12"}
      },
      {
        "src": "Postify/build_files.sh",
        "use": "@vercel/static-build",
        "config":{
            "distDir":"staticfiles_build"
        }
      },
      {
        "src": "Postify/staticfiles",
        "use": "@vercel/static"
      }
    ],
    "routes": [
      {
        "src": "Postify/static/(.*)",
        "dest": "Postify/staticfiles/$1"
      },
      {
        "src": "/(.*)",
        "dest": "Postify/TweetLearn/wsgi.py"
      }
    ]
  }
  